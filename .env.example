# Copy this file to .env and fill in your values. .env is gitignored - never commit it.

# OpenAI (or any OpenAI-compatible hosted provider)
SHIFTCODE_LLM_API_KEY=sk-...
SHIFTCODE_LLM_MODEL=gpt-4o-mini

# For a local model instead (Ollama, LM Studio, vLLM), set base_url and drop the
# api key requirement (or leave a placeholder - most local servers ignore it):
# SHIFTCODE_LLM_BASE_URL=http://localhost:11434/v1
# SHIFTCODE_LLM_MODEL=llama3

# Optional: explicit python2 interpreter path (else auto-detected on PATH, then Docker)
# SHIFTCODE_PY2_INTERPRETER=/usr/bin/python2
